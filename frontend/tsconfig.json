{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src/lib/syllabifier/**/*.ts",
    "src/lib/barMatcher/**/*.ts",
    "src/lib/barRepo/**/*.ts",
    "src/lib/vault/**/*.ts",
    "src/features/dawra/**/*.ts",
    "src/features/dawra/**/*.tsx"
  ]
}
